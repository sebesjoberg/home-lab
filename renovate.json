    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^infra/.+\\.ya?ml$/", "/^workloads/.+\\.ya?ml$/"]
  },
