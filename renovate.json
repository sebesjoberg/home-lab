{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "argocd": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^infra/.+\\.ya?ml$/", "/^workloads/.+\\.ya?ml$/"]
  },
  "kustomize": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Private Harbor image, bumped manually; hosted Renovate can't reach it",
      "matchPackageNames": ["harbor.sebhome.homes/**"],
      "enabled": false
    }
  ]
}
